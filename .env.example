# Copy to .env.local to persist to the real SQL (SQLite) backend in server/
# instead of this browser's IndexedDB. Also run the API server:
#   npm run server        (just the API, port 8787 by default)
#   npm run dev:all        (Vite + the API together)
# Leave unset (the default) for the original local-only, no-server build.
VITE_USE_API=true
